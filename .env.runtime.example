# Used by Docker entrypoint:
# docker/entrypoint/40-generate-app-config.sh
#
# Note:
# - Local `ng serve` reads `public/assets/app-config.js` directly.
# - This file is only a sample for container/deploy runtime env.

# Local default
APP_API_BASE_URL=http://localhost:8081

# Production sample
# APP_API_BASE_URL=https://api.example.com

# Leave empty if local does not use Google login
APP_GOOGLE_CLIENT_ID=
